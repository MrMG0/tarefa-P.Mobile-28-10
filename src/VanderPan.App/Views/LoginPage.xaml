<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPan.App.Views.LoginPage"
             Title="Acesso do Vendedor"
             BackgroundColor="#FAF8F5">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            
            <Label Text="🥐" FontSize="64" HorizontalOptions="Center" />
            <Label Text="VanderPan" FontSize="32" FontAttributes="Bold" TextColor="#D97706" HorizontalOptions="Center" />
            <Label Text="Distribuidora de Produtos de Panificação" FontSize="14" TextColor="#6B7280" HorizontalOptions="Center" />

            <Frame BackgroundColor="White" CornerRadius="16" HasShadow="True" Padding="24" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Acesso Inicial do Vendedor" FontSize="18" FontAttributes="Bold" TextColor="#1F2937" />
                    <Label Text="Faça o cadastro/login na primeira inicialização. A sessão ficará salva no dispositivo." FontSize="12" TextColor="#6B7280" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="E-mail" FontSize="13" FontAttributes="Bold" TextColor="#374151" />
                        <Entry x:Name="EmailEntry" Placeholder="seu.email@vanderpan.com.br" Keyboard="Email" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Senha" FontSize="13" FontAttributes="Bold" TextColor="#374151" />
                        <Entry x:Name="SenhaEntry" IsPassword="True" Placeholder="Digite sua senha" />
                    </VerticalStackLayout>

                    <Label x:Name="MensagemLabel" TextColor="#EF4444" FontSize="13" IsVisible="False" />

                    <Button x:Name="EntrarButton" Text="Entrar / Conectar" 
                            BackgroundColor="#D97706" TextColor="White" FontAttributes="Bold" CornerRadius="10"
                            Clicked="OnEntrarClicked" />

                    <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="#D97706" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="VanderPan Mobile B2B • Vendedor Externo" FontSize="12" TextColor="#9CA3AF" HorizontalOptions="Center" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
