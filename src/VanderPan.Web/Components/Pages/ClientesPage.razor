@page "/clientes"
@inject ApiService Api

<PageTitle>Clientes (Padarias) - VanderPan</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Carteira de Clientes (Padarias e Confeitarias)</h2>
        <p class="text-muted mb-0">Gestão de estabelecimentos B2B com roteiro de visitas espaçado (10, 20, 30...)</p>
    </div>
    <button class="btn btn-primary fw-semibold" @onclick="AbrirModalNovo">
        ➕ Cadastrar Novo Cliente
    </button>
</div>

<!-- FILTROS -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <input type="text" class="form-control" placeholder="Buscar por Razão Social, Nome Fantasia ou CNPJ..." 
                       @bind="buscaTexto" @bind:after="CarregarClientes" />
            </div>
            <div class="col-md-4">
                <select class="form-select" @bind="filtroVendedor" @bind:after="CarregarClientes">
                    <option value="0">Todos os Vendedores</option>
                    @foreach (var v in vendedores)
                    {
                        <option value="@v.Id">@v.Nome</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-outline-secondary w-100" @onclick="CarregarClientes">
                    Filtrar Clientes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- TABELA DE CLIENTES -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center">Seq. Visita</th>
                    <th>Razão Social / Nome Fantasia</th>
                    <th>CNPJ</th>
                    <th>Cidade / UF</th>
                    <th>Vendedor Responsável</th>
                    <th>Telefone</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (carregando)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                        </td>
                    </tr>
                }
                else if (!clientes.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            Nenhum cliente encontrado.
                        </td>
                    </tr>
                }
                @foreach (var c in clientes)
                {
                    <tr>
                        <td class="text-center">
                            <span class="badge bg-dark fs-6" title="Ordem no roteiro de visitas">
                                @c.SequenciaVisita
                            </span>
                        </td>
                        <td>
                            <div class="fw-bold">@c.RazaoSocial</div>
                            <small class="text-muted">@(c.NomeFantasia ?? "Sem nome fantasia")</small>
                        </td>
                        <td>@c.Cnpj</td>
                        <td>@(c.Cidade?.Nome ?? "-") / @(c.Cidade?.Estado?.Uf ?? "-")</td>
                        <td>@(c.Vendedor?.Nome ?? "-")</td>
                        <td>@(c.Telefone ?? "-")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-danger" @onclick="() => VerDebitos(c)" title="Consultar Débitos">
                                    💰 Débitos
                                </button>
                                <button class="btn btn-outline-info" @onclick="() => VerHistorico(c)" title="Histórico de Compras">
                                    📜 Histórico
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="() => EditarCliente(c)" title="Editar">
                                    ✏️
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL CADASTRAR / EDITAR CLIENTE -->
@if (exibirModalCadastro)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">@(clienteEmEdicao.Id == 0 ? "Novo Cliente" : "Editar Cliente")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalCadastro = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Razão Social *</label>
                            <input type="text" class="form-control" @bind="clienteEmEdicao.RazaoSocial" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Nome Fantasia</label>
                            <input type="text" class="form-control" @bind="clienteEmEdicao.NomeFantasia" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">CNPJ *</label>
                            <input type="text" class="form-control" @bind="clienteEmEdicao.Cnpj" placeholder="00.000.000/0000-00" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">E-mail</label>
                            <input type="email" class="form-control" @bind="clienteEmEdicao.Email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Telefone</label>
                            <input type="text" class="form-control" @bind="clienteEmEdicao.Telefone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Vendedor Responsável *</label>
                            <select class="form-select" @bind="clienteEmEdicao.IdVendedor">
                                <option value="0">-- Selecione o Vendedor --</option>
                                @foreach (var v in vendedores)
                                {
                                    <option value="@v.Id">@v.Nome</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Sequência de Visita (Rota) *</label>
                            <input type="number" class="form-control" @bind="clienteEmEdicao.SequenciaVisita" 
                                   placeholder="Ex: 10, 15, 20, 30..." />
                            <small class="text-muted">Use espaçamento (ex: 15 entre 10 e 20)</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Cidade</label>
                            <select class="form-select" @bind="clienteEmEdicao.IdCidade">
                                <option value="">-- Selecione a Cidade --</option>
                                @foreach (var cid in cidades)
                                {
                                    <option value="@cid.Id">@cid.Nome (@cid.Estado?.Uf)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">CEP</label>
                            <input type="text" class="form-control" @bind="clienteEmEdicao.Cep" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Rua / Logradouro</label>
                            <input type="text" class="form-control" @bind="clienteEmEdicao.Rua" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold">Número</label>
                            <input type="text" class="form-control" @bind="clienteEmEdicao.Numero" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Bairro</label>
                            <input type="text" class="form-control" @bind="clienteEmEdicao.Bairro" />
                        </div>
                    </div>

                    @if (erroCadastro != null)
                    {
                        <div class="alert alert-danger py-2 mt-3 small">@erroCadastro</div>
                    }
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => exibirModalCadastro = false">Cancelar</button>
                    <button type="button" class="btn btn-primary fw-bold" @onclick="SalvarCliente">Salvar Cliente</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL CONSULTA DE DÉBITOS DO CLIENTE -->
@if (debitosCliente != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">💰 Posição Financeira: @debitosCliente.RazaoSocial</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => debitosCliente = null"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border text-center">
                                <span class="text-muted small">Total em Aberto (A Vencer):</span>
                                <h4 class="fw-bold text-dark mb-0">R$ @debitosCliente.TotalEmAberto.ToString("N2")</h4>
                                <small class="text-muted">@debitosCliente.QuantidadeTitulosAbertos título(s)</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border text-center border-danger">
                                <span class="text-danger small fw-semibold">Total Vencido (Em Atraso):</span>
                                <h4 class="fw-bold text-danger mb-0">R$ @debitosCliente.TotalVencido.ToString("N2")</h4>
                                <small class="text-danger">@debitosCliente.QuantidadeTitulosVencidos título(s) vencido(s)</small>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-2">Títulos em Aberto ou Vencidos</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Documento</th>
                                    <th>Vencimento</th>
                                    <th>Valor Original</th>
                                    <th>Forma Pgto</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!debitosCliente.Titulos.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-3 text-success fw-semibold">
                                            🎉 Parabéns! Este cliente não possui títulos em aberto ou vencidos.
                                        </td>
                                    </tr>
                                }
                                @foreach (var t in debitosCliente.Titulos)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@t.NumeroDocumento</td>
                                        <td>@t.DataVencimento.ToString("dd/MM/yyyy")</td>
                                        <td class="fw-bold">R$ @t.ValorOriginal.ToString("N2")</td>
                                        <td><span class="badge bg-secondary">@t.FormaPagamento</span></td>
                                        <td>
                                            <span class="badge @(t.Status == StatusContaReceber.VENCIDO ? "bg-danger" : "bg-warning text-dark")">
                                                @t.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => debitosCliente = null">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL HISTÓRICO DE COMPRAS (ÚLTIMA COMPRA POR PRODUTO) -->
@if (historicoCompras != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title fw-bold">📜 Histórico de Compras: @clienteHistoricoNome</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => historicoCompras = null"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Produtos já comprados pelo cliente com dados da última aquisição (quantidade, preço e data):</p>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Produto</th>
                                    <th class="text-center">Última Qtd Comprada</th>
                                    <th class="text-end">Último Preço</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-center">Data da Compra</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!historicoCompras.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-3 text-muted">
                                            Nenhuma compra registrada para este cliente.
                                        </td>
                                    </tr>
                                }
                                @foreach (var h in historicoCompras)
                                {
                                    <tr>
                                        <td class="fw-bold">@h.NomeProduto</td>
                                        <td class="text-center">@h.Quantidade</td>
                                        <td class="text-end">R$ @h.PrecoUnitario.ToString("N2")</td>
                                        <td class="text-end fw-semibold">R$ @h.Subtotal.ToString("N2")</td>
                                        <td class="text-center">@h.DataCompra.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => historicoCompras = null">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool carregando = true;
    private List<Cliente> clientes = new();
    private List<Vendedor> vendedores = new();
    private List<Cidade> cidades = new();

    private string buscaTexto = "";
    private int filtroVendedor = 0;

    private bool exibirModalCadastro = false;
    private Cliente clienteEmEdicao = new();
    private string? erroCadastro;

    private ClienteDebitosDTO? debitosCliente;
    private List<ItemUltimaCompraDTO>? historicoCompras;
    private string clienteHistoricoNome = "";

    protected override async Task OnInitializedAsync()
    {
        vendedores = await Api.GetVendedoresAsync();
        cidades = await Api.GetCidadesAsync();
        await CarregarClientes();
    }

    private async Task CarregarClientes()
    {
        carregando = true;
        clientes = await Api.GetClientesAsync(filtroVendedor > 0 ? filtroVendedor : null, buscaTexto);
        carregando = false;
    }

    private void AbrirModalNovo()
    {
        clienteEmEdicao = new Cliente
        {
            IdVendedor = vendedores.FirstOrDefault()?.Id ?? 0,
            IdCidade = cidades.FirstOrDefault()?.Id,
            SequenciaVisita = (clientes.Any() ? clientes.Max(c => c.SequenciaVisita) + 10 : 10)
        };
        erroCadastro = null;
        exibirModalCadastro = true;
    }

    private void EditarCliente(Cliente c)
    {
        clienteEmEdicao = new Cliente
        {
            Id = c.Id,
            RazaoSocial = c.RazaoSocial,
            NomeFantasia = c.NomeFantasia,
            Cnpj = c.Cnpj,
            Email = c.Email,
            Telefone = c.Telefone,
            Cep = c.Cep,
            Rua = c.Rua,
            Numero = c.Numero,
            Bairro = c.Bairro,
            IdCidade = c.IdCidade,
            IdVendedor = c.IdVendedor,
            SequenciaVisita = c.SequenciaVisita,
            Ativo = c.Ativo
        };
        erroCadastro = null;
        exibirModalCadastro = true;
    }

    private async Task SalvarCliente()
    {
        if (string.IsNullOrWhiteSpace(clienteEmEdicao.RazaoSocial) || string.IsNullOrWhiteSpace(clienteEmEdicao.Cnpj) || clienteEmEdicao.IdVendedor == 0)
        {
            erroCadastro = "Preencha Razão Social, CNPJ e Vendedor Responsável.";
            return;
        }

        var ok = await Api.SalvarClienteAsync(clienteEmEdicao);
        if (ok)
        {
            exibirModalCadastro = false;
            await CarregarClientes();
        }
        else
        {
            erroCadastro = "Erro ao salvar cliente. Verifique se o CNPJ já está cadastrado.";
        }
    }

    private async Task VerDebitos(Cliente cliente)
    {
        debitosCliente = await Api.GetDebitosClienteAsync(cliente.Id);
    }

    private async Task VerHistorico(Cliente cliente)
    {
        clienteHistoricoNome = cliente.RazaoSocial;
        historicoCompras = await Api.GetHistoricoClienteAsync(cliente.Id);
    }
}
