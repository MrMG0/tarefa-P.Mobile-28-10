<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:VanderPan.Core.Models;assembly=VanderPan.Core"
             x:Class="VanderPan.App.Views.RoteiroPage"
             Title="Roteiro de Visitas"
             BackgroundColor="#FAF8F5">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- CABEÇALHO -->
        <Frame Grid.Row="0" BackgroundColor="#D97706" CornerRadius="0" Padding="20,16" HasShadow="True">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0">
                    <Label x:Name="VendedorNomeLabel" Text="Olá, Vendedor!" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Roteiro ordenado por sequência de rota (10, 20, 30...)" FontSize="12" TextColor="#FDE68A" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="➕ Cliente" BackgroundColor="White" TextColor="#D97706" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Clicked="OnNovoClienteClicked" />
                <Button Grid.Column="2" Text="Sair" BackgroundColor="#B45309" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Clicked="OnSairClicked" />
            </Grid>
        </Frame>

        <!-- LISTA DE CLIENTES NA ORDEM DA SEQUENCIA -->
        <RefreshView Grid.Row="1" x:Name="RoteiroRefresh" Refreshing="OnRefreshing">
            <CollectionView x:Name="ClientesCollection">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="30" Spacing="10">
                        <Label Text="🏬" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Nenhum cliente na carteira." FontSize="16" TextColor="#6B7280" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Cliente">
                        <Frame Margin="16,8" Padding="16" CornerRadius="12" BackgroundColor="White" HasShadow="True">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClienteTapped" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <!-- SEQUÊNCIA ESPAÇADA -->
                                <Frame Grid.Column="0" BackgroundColor="#FEF3C7" BorderColor="#D97706" CornerRadius="8" Padding="10,6" VerticalOptions="Center">
                                    <VerticalStackLayout HorizontalOptions="Center">
                                        <Label Text="ROTA" FontSize="9" FontAttributes="Bold" TextColor="#B45309" HorizontalOptions="Center" />
                                        <Label Text="{Binding SequenciaVisita}" FontSize="18" FontAttributes="Bold" TextColor="#92400E" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Frame>

                                <!-- DADOS DO CLIENTE -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding RazaoSocial}" FontSize="16" FontAttributes="Bold" TextColor="#1F2937" MaxLines="1" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding NomeFantasia}" FontSize="13" TextColor="#4B5563" />
                                    <Label Text="{Binding Cnpj}" FontSize="11" TextColor="#9CA3AF" />
                                    <Label Text="{Binding Rua, StringFormat='📍 {0}'}" FontSize="12" TextColor="#6B7280" MaxLines="1" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2" Text="➔" FontSize="20" TextColor="#D97706" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- BARRA INFERIOR DE DISPARO DE PEDIDOS -->
        <Frame Grid.Row="2" BackgroundColor="White" CornerRadius="0" Padding="16,12" HasShadow="True" BorderColor="#E5E7EB">
            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" Text="📦 Meus Pedidos" BackgroundColor="#E5E7EB" TextColor="#1F2937" FontAttributes="Bold" CornerRadius="8" Margin="0,0,6,0" Clicked="OnMeusPedidosClicked" />
                <Button Grid.Column="1" Text="🚀 Disparar Pedidos" BackgroundColor="#059669" TextColor="White" FontAttributes="Bold" CornerRadius="8" Margin="6,0,0,0" Clicked="OnDispararPedidosClicked" />
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
