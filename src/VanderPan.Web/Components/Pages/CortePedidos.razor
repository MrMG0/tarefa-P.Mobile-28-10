@page "/corte"
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Corte de Pedidos - VanderPan</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Corte de Pedidos (Gestão de Estoque)</h2>
        <p class="text-muted mb-0">Distribuição proporcional inteligente priorizando clientes com histórico de adimplência</p>
    </div>
    <a href="pedidos" class="btn btn-outline-secondary">
        ← Voltar aos Pedidos
    </a>
</div>

<!-- SELEÇÃO DE PRODUTO E JANELA -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">1. Selecionar Produto para Triagem de Corte</h5>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label small fw-semibold">Produto</label>
                <select class="form-select" @bind="idProdutoSelecionado">
                    <option value="0">-- Selecione um produto --</option>
                    @foreach (var p in produtos)
                    {
                        <option value="@p.Id">@p.Nome (Estoque: @p.Estoque @p.UnidadeMedida)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Janela de Entrega</label>
                <select class="form-select" @bind="janelaSelecionada">
                    <option value="">Todas as Janelas</option>
                    <option value="H12">Janela 12h</option>
                    <option value="H19">Janela 19h</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-warning w-100 fw-semibold" @onclick="ConsultarSugestao" disabled="@(idProdutoSelecionado == 0 || calculando)">
                    @if (calculando)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Calculando...</span>
                    }
                    else
                    {
                        <span>⚡ Calcular Sugestão</span>
                    }
                </button>
            </div>
        </div>

        @if (produtoAtual != null)
        {
            <div class="mt-3 p-3 bg-light rounded-3 d-flex justify-content-between align-items-center border">
                <div>
                    <span class="badge @(produtoAtual.Perecivel ? "bg-danger" : "bg-secondary") me-2">
                        @(produtoAtual.Perecivel ? "PRODUTO PERECÍVEL" : "NÃO PERECÍVEL")
                    </span>
                    <strong class="text-dark fs-6">@produtoAtual.Nome</strong>
                    <span class="text-muted ms-2">Preço: R$ @produtoAtual.Preco.ToString("N2")</span>
                </div>
                <div>
                    <span class="text-muted me-2">Estoque Disponível no Galpão:</span>
                    <span class="badge bg-primary fs-6">@produtoAtual.Estoque @produtoAtual.UnidadeMedida</span>
                </div>
            </div>
        }
    </div>
</div>

<!-- TABELA DE SUGESTÃO E AJUSTE MANUAL -->
@if (sugestoes.Any())
{
    var totalPedido = sugestoes.Sum(s => s.QuantidadePedida);
    var totalSugerido = sugestoes.Sum(s => s.QuantidadeSugerida);
    var estoqueDisponivel = produtoAtual?.Estoque ?? 0m;
    var deficit = totalPedido - estoqueDisponivel;

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0">2. Revisão e Ajuste de Quantidades por Cliente</h5>
                <small class="text-muted">Revise os valores sugeridos pelo algoritmo ou edite manualmente conforme a necessidade</small>
            </div>
            @if (deficit > 0)
            {
                <span class="badge bg-danger fs-6">
                    ⚠️ Déficit de Estoque: @deficit.ToString("N3") @produtoAtual?.UnidadeMedida
                </span>
            }
            else
            {
                <span class="badge bg-success fs-6">
                    ✅ Estoque suficiente para atender integralmente
                </span>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Pedido</th>
                            <th>Cliente / Padaria</th>
                            <th>Situação Financeira</th>
                            <th class="text-center">Qtd Pedida</th>
                            <th class="text-center" style="width: 180px;">Qtd a Entregar (Ajustável)</th>
                            <th class="text-end">% Atendido</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in sugestoes)
                        {
                            <tr>
                                <td class="fw-bold">#@item.IdPedido</td>
                                <td>
                                    <div class="fw-semibold">@item.NomeCliente</div>
                                    <small class="text-muted">Item #@item.IdItemPedido</small>
                                </td>
                                <td>
                                    @if (item.PossuiDividaVencida)
                                    {
                                        <span class="badge bg-danger" title="Cliente possui títulos em atraso">
                                            ⚠️ Débito Vencido (R$ @item.ValorDividaVencida.ToString("N2"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success" title="Cliente sem dívidas vencidas">
                                            ⭐ Em Dia / Bom Pagador
                                        </span>
                                    }
                                </td>
                                <td class="text-center fw-semibold">
                                    @item.QuantidadePedida
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="0.5" min="0" max="@item.QuantidadePedida"
                                               class="form-control text-center fw-bold @(item.QuantidadeSugerida < item.QuantidadePedida ? "border-warning text-warning" : "text-success")"
                                               @bind="item.QuantidadeSugerida" />
                                        <span class="input-group-text">@produtoAtual?.UnidadeMedida</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <span class="badge @(item.PercentualAtendimento >= 100 ? "bg-success" : (item.PercentualAtendimento >= 50 ? "bg-warning text-dark" : "bg-danger"))">
                                        @item.PercentualAtendimento%
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light">
                            <th colspan="3" class="text-end">Totais:</th>
                            <th class="text-center">@totalPedido</th>
                            <th class="text-center fw-bold fs-6 @(totalSugerido > estoqueDisponivel ? "text-danger" : "text-primary")">
                                @totalSugerido / @estoqueDisponivel
                            </th>
                            <th class="text-end">
                                @(totalPedido > 0 ? Math.Round((totalSugerido / totalPedido) * 100m, 1) : 0)%
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                @if (totalSugerido > estoqueDisponivel)
                {
                    <span class="text-danger fw-semibold">
                        ❌ Atenção: O total a entregar (@totalSugerido) ultrapassa o estoque disponível (@estoqueDisponivel). Ajuste as quantidades.
                    </span>
                }
                else
                {
                    <span class="text-success fw-semibold">
                        ✔️ Alocação válida! O estoque restante será de @((estoqueDisponivel - totalSugerido).ToString("N3")) @produtoAtual?.UnidadeMedida.
                    </span>
                }
            </div>
            <button class="btn btn-success fw-bold px-4" 
                    @onclick="ConfirmarCorte" 
                    disabled="@(totalSugerido > estoqueDisponivel || salvandoCorte)">
                @if (salvandoCorte)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Salvando Corte...</span>
                }
                else
                {
                    <span>💾 Confirmar e Aplicar Corte</span>
                }
            </button>
        </div>
    </div>
}
else if (consultou && !calculando)
{
    <div class="alert alert-info py-4 text-center border-0 shadow-sm">
        <h5>Nenhum pedido pendente com este produto</h5>
        <p class="mb-0 text-muted">Não foram encontrados pedidos pendentes de entrega para o produto e janela selecionados.</p>
    </div>
}

@if (mensagemSucesso != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <strong>Sucesso!</strong> @mensagemSucesso
        <button type="button" class="btn-close" @onclick="() => mensagemSucesso = null"></button>
    </div>
}

@code {
    private List<Produto> produtos = new();
    private int idProdutoSelecionado;
    private string janelaSelecionada = "";
    private Produto? produtoAtual;

    private List<ItemCorteSugestaoOutput> sugestoes = new();
    private bool calculando = false;
    private bool consultou = false;
    private bool salvandoCorte = false;
    private string? mensagemSucesso;

    protected override async Task OnInitializedAsync()
    {
        produtos = await Api.GetProdutosAsync();
    }

    private async Task ConsultarSugestao()
    {
        if (idProdutoSelecionado == 0) return;

        calculando = true;
        consultou = true;
        mensagemSucesso = null;

        produtoAtual = produtos.FirstOrDefault(p => p.Id == idProdutoSelecionado);

        JanelaEntrega? janela = null;
        if (!string.IsNullOrEmpty(janelaSelecionada) && Enum.TryParse<JanelaEntrega>(janelaSelecionada, out var j))
        {
            janela = j;
        }

        sugestoes = await Api.ObterSugestaoCorteAsync(idProdutoSelecionado, janela);
        calculando = false;
    }

    private async Task ConfirmarCorte()
    {
        salvandoCorte = true;

        var itensDTO = sugestoes.Select(s => new ItemCorteInputDTO
        {
            IdItemPedido = s.IdItemPedido,
            QuantidadeEntregue = s.QuantidadeSugerida
        }).ToList();

        var ok = await Api.AplicarCorteAsync(itensDTO);
        salvandoCorte = false;

        if (ok)
        {
            mensagemSucesso = $"Corte aplicado com sucesso para {sugestoes.Count} item(ns). Pedidos atualizados para status 'CORTADO'.";
            sugestoes.Clear();
            consultou = false;
        }
    }
}
